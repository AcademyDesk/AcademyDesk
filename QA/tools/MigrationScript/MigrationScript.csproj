<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(CandidateDirectory)/*.dll" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CandidateDirectory)/AcademyDesk.Api.dll')" Text="Exact candidate publish directory is required." />
  </Target>
</Project>
