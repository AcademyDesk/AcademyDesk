{
  "$defs": {
    "AuthenticatedScope": {
      "additionalProperties": false,
      "description": "Values must be created from host authentication, never from model/chat.",
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "authority_version": {
          "minimum": 1,
          "title": "Authority Version",
          "type": "integer"
        },
        "connection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Connection Id",
          "type": "string"
        },
        "context_version": {
          "minimum": 1,
          "title": "Context Version",
          "type": "integer"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Conversation Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "actor_id",
        "connection_id",
        "conversation_id",
        "authority_version",
        "context_version"
      ],
      "title": "AuthenticatedScope",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "boolean",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "CapabilityAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "key": {
          "enum": [
            "Pulse",
            "Executor",
            "Navigator",
            "Twin",
            "Autopilot"
          ],
          "title": "Key",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "key",
        "available",
        "reason"
      ],
      "title": "CapabilityAvailability",
      "type": "object"
    },
    "ChartArtifact": {
      "additionalProperties": false,
      "properties": {
        "chart": {
          "enum": [
            "bar",
            "line"
          ],
          "title": "Chart",
          "type": "string"
        },
        "kind": {
          "const": "chart",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AuthenticatedScope"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "scope",
        "title",
        "chart",
        "unit",
        "points",
        "provenance"
      ],
      "title": "ChartArtifact",
      "type": "object"
    },
    "ChartPoint": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,6})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "ChartPoint",
      "type": "object"
    },
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Controls": {
      "additionalProperties": false,
      "properties": {
        "cancel": {
          "title": "Cancel",
          "type": "boolean"
        },
        "confirm": {
          "title": "Confirm",
          "type": "boolean"
        },
        "feedback": {
          "title": "Feedback",
          "type": "boolean"
        },
        "history": {
          "title": "History",
          "type": "boolean"
        },
        "pause": {
          "title": "Pause",
          "type": "boolean"
        },
        "prepare": {
          "title": "Prepare",
          "type": "boolean"
        },
        "reconcile": {
          "title": "Reconcile",
          "type": "boolean"
        },
        "resume": {
          "title": "Resume",
          "type": "boolean"
        },
        "secure_media": {
          "title": "Secure Media",
          "type": "boolean"
        },
        "send": {
          "title": "Send",
          "type": "boolean"
        }
      },
      "required": [
        "send",
        "prepare",
        "confirm",
        "cancel",
        "pause",
        "resume",
        "reconcile",
        "history",
        "feedback",
        "secure_media"
      ],
      "title": "Controls",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "date",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 10,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DecimalValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "decimal",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,6})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "DecimalValue",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "maxLength": 40,
          "title": "As Of",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "expires_at": {
          "maxLength": 40,
          "title": "Expires At",
          "type": "string"
        },
        "facts": {
          "maxProperties": 30,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_]*$": {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanValue",
                  "date": "#/$defs/DateValue",
                  "decimal": "#/$defs/DecimalValue",
                  "integer": "#/$defs/IntegerValue",
                  "reference": "#/$defs/ReferenceValue",
                  "text": "#/$defs/TextValue"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextValue"
                },
                {
                  "$ref": "#/$defs/IntegerValue"
                },
                {
                  "$ref": "#/$defs/DecimalValue"
                },
                {
                  "$ref": "#/$defs/BooleanValue"
                },
                {
                  "$ref": "#/$defs/DateValue"
                },
                {
                  "$ref": "#/$defs/ReferenceValue"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Facts",
          "type": "object"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AuthenticatedScope"
        },
        "source_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Ref",
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "revoked",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "scope",
        "source_ref",
        "as_of",
        "expires_at",
        "coverage",
        "status",
        "facts"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 100,
          "title": "Choices",
          "type": "array"
        },
        "clearable": {
          "title": "Clearable",
          "type": "boolean"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "maxItems": 16,
          "title": "Columns",
          "type": "array"
        },
        "key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "integer",
            "decimal",
            "boolean",
            "date",
            "reference",
            "rows"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "max_length": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "required",
        "clearable",
        "choices",
        "columns",
        "max_length"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "HistoryItem": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "title"
      ],
      "title": "HistoryItem",
      "type": "object"
    },
    "HostDraft": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "maxProperties": 40,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_]*$": {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanValue",
                  "date": "#/$defs/DateValue",
                  "decimal": "#/$defs/DecimalValue",
                  "integer": "#/$defs/IntegerValue",
                  "reference": "#/$defs/ReferenceValue",
                  "rows": "#/$defs/RowsValue",
                  "text": "#/$defs/TextValue"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextValue"
                },
                {
                  "$ref": "#/$defs/IntegerValue"
                },
                {
                  "$ref": "#/$defs/DecimalValue"
                },
                {
                  "$ref": "#/$defs/BooleanValue"
                },
                {
                  "$ref": "#/$defs/DateValue"
                },
                {
                  "$ref": "#/$defs/ReferenceValue"
                },
                {
                  "$ref": "#/$defs/RowsValue"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Fields",
          "type": "object"
        },
        "operation_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation Ref"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "collecting",
            "prepared",
            "awaiting_approval",
            "approved",
            "executing",
            "succeeded",
            "failed",
            "cancelled",
            "paused",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Tool Key",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "revision",
        "tool_key",
        "fields",
        "status",
        "operation_ref"
      ],
      "title": "HostDraft",
      "type": "object"
    },
    "HostSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "maxLength": 40,
          "title": "As Of",
          "type": "string"
        },
        "availability": {
          "enum": [
            "ready",
            "denied",
            "unavailable",
            "stale"
          ],
          "title": "Availability",
          "type": "string"
        },
        "catalog_revision": {
          "minimum": 1,
          "title": "Catalog Revision",
          "type": "integer"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/AuthenticatedScope"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolDescriptor"
          },
          "maxItems": 50,
          "title": "Tools",
          "type": "array"
        },
        "version": {
          "const": "operational-draft-0.3.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "scope",
        "as_of",
        "catalog_revision",
        "tools",
        "draft",
        "evidence",
        "availability"
      ],
      "title": "HostSnapshot",
      "type": "object"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 20,
          "title": "Choices",
          "type": "array"
        },
        "code": {
          "enum": [
            "required",
            "invalid",
            "duplicate_candidates",
            "ambiguous_reference",
            "secure_host_step",
            "business_rule"
          ],
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field"
        }
      },
      "required": [
        "field",
        "code",
        "choices"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "user",
            "observed",
            "hypothesis",
            "recommendation",
            "status"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Refs",
          "type": "array"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "kind",
        "text",
        "source_refs"
      ],
      "title": "Message",
      "type": "object"
    },
    "ModelOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "label",
        "qualified"
      ],
      "title": "ModelOption",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "discriminator": {
              "mapping": {
                "chart": "#/$defs/ChartArtifact",
                "table": "#/$defs/TableArtifact",
                "text": "#/$defs/TextArtifact"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextArtifact"
              },
              {
                "$ref": "#/$defs/TableArtifact"
              },
              {
                "$ref": "#/$defs/ChartArtifact"
              }
            ]
          },
          "maxItems": 20,
          "title": "Artifacts",
          "type": "array"
        },
        "request_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Ref",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AuthenticatedScope"
        },
        "version": {
          "const": "operational-draft-0.3.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "scope",
        "request_ref",
        "artifacts"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PreparedOperation": {
      "additionalProperties": false,
      "description": "Only a trusted host may issue these references/canonical payload hashes.",
      "properties": {
        "approval_expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Expires At"
        },
        "approval_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Ref"
        },
        "canonical_fields": {
          "maxProperties": 40,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_]*$": {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanValue",
                  "date": "#/$defs/DateValue",
                  "decimal": "#/$defs/DecimalValue",
                  "integer": "#/$defs/IntegerValue",
                  "reference": "#/$defs/ReferenceValue",
                  "rows": "#/$defs/RowsValue",
                  "text": "#/$defs/TextValue"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextValue"
                },
                {
                  "$ref": "#/$defs/IntegerValue"
                },
                {
                  "$ref": "#/$defs/DecimalValue"
                },
                {
                  "$ref": "#/$defs/BooleanValue"
                },
                {
                  "$ref": "#/$defs/DateValue"
                },
                {
                  "$ref": "#/$defs/ReferenceValue"
                },
                {
                  "$ref": "#/$defs/RowsValue"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Canonical Fields",
          "type": "object"
        },
        "draft_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Draft Ref",
          "type": "string"
        },
        "draft_revision": {
          "minimum": 1,
          "title": "Draft Revision",
          "type": "integer"
        },
        "payload_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "preview": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Preview",
          "type": "string"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Ref",
          "type": "string"
        },
        "request_ref": {
          "maxLength": 128,
